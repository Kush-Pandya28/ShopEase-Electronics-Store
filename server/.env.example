# Server
NODE_ENV=development
PORT=5000
# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/shopease

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments (Razorpay test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Set true to simulate online payments locally when Razorpay keys are not available (never in production)
PAYMENT_MOCK=true

# Email (leave SMTP_HOST empty to log emails to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ShopEase <no-reply@shopease.com>
ADMIN_EMAIL=admin@shopease.com

# Inventory
LOW_STOCK_THRESHOLD=5

# Admin login created automatically on start-up (leave empty to use the demo admin)
ADMIN_NAME=
ADMIN_LOGIN_EMAIL=
ADMIN_LOGIN_PASSWORD=
